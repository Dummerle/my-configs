set $super Mod4
set $alt Mod1

# set keyboard layout
# exec "setxkbmap de"

input * {
    xkb_layout "de"
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

output eDP-1 mode 2256x1504 scale 1
output DP-3 mode 1920x1080@143.981Hz

bindsym $super+greater move workspace to output right
bindsym $super+less move workspace to output left

#set font
font pango:JetBrainsMono Nerd Font 11

#####################[WINDOWS AND WORKSPACES]#######################
# Use Mouse+$super to drag floating windows to their wanted position
floating_modifier $super

default_border pixel 0

#set the gaps
gaps inner 10
gaps outer 10


#smart_borders on
smart_gaps on

# kill focused window
bindsym $super+q kill

#tags
set $tag1 
set $tag2 
set $tag3 
set $tag4 
set $tag5 
set $tag6 
set $tag7 
set $tag8 
set $tag9 
set $tag10 

set $terminal "foot"

# change focus
bindsym $super+Left focus left
bindsym $super+Down focus down
bindsym $super+Up focus up
bindsym $super+Right focus right

# Move window
bindsym $super+Shift+Left move left
bindsym $super+Shift+Down move down
bindsym $super+Shift+Up move up
bindsym $super+Shift+Right move right

# split in horizontal orientation
bindsym $super+h split h

# split in vertical orientation
bindsym $super+v split v

# enter fullscreen mode for the focused container
bindsym $super+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
#bindsym $super+s layout stacking
#bindsym $super+w layout tabbed
#bindsym $super+e layout toggle split

# toggle tiling / floating
bindsym $super+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $super+space focus mode_toggle

bindsym $super+Shift+r mode "resize"
mode "resize" {
    # same bindings, but for the arrow keys
    bindsym Left resize shrink width 1 px or 1 ppt
    bindsym Down resize grow height 1 px or 1 ppt
    bindsym Up resize shrink height 1 px or 1 ppt
    bindsym Right resize grow width 1 px or 1 ppt

    # same bindings, but for the arrow keys
    bindsym Control+Left resize shrink width 5 px or 5 ppt
    bindsym Control+Down resize grow height 5 px or 5 ppt
    bindsym Control+Up resize shrink height 5 px or 5 ppt
    bindsym Control+Right resize grow width 5 px or 5 ppt

   # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"

    ## Title / show / hide border ##
    bindsym o border toggle

    ## Back to normal ##
    bindsym $super+r  mode "default"
}

# switch to workspace
bindsym $super+1 workspace 1 $tag1
bindsym $super+2 workspace 2 $tag2
bindsym $super+3 workspace 3 $tag3
bindsym $super+4 workspace 4 $tag4
bindsym $super+5 workspace 5 $tag5
bindsym $super+6 workspace 6 $tag6
bindsym $super+7 workspace 7 $tag7
bindsym $super+8 workspace 8 $tag8
bindsym $super+9 workspace 9 $tag9
bindsym $super+0 workspace 10 $tag10

# PageUp & PageDown
bindsym $super+Prior workspace prev
bindsym $super+Next workspace next

# move focused container to workspace
bindsym $super+Shift+1 move container to workspace 1 $tag1
bindsym $super+Shift+2 move container to workspace 2 $tag2
bindsym $super+Shift+3 move container to workspace 3 $tag3
bindsym $super+Shift+4 move container to workspace 4 $tag4
bindsym $super+Shift+5 move container to workspace 5 $tag5
bindsym $super+Shift+6 move container to workspace 6 $tag6
bindsym $super+Shift+7 move container to workspace 7 $tag7
bindsym $super+Shift+8 move container to workspace 8 $tag8
bindsym $super+Shift+9 move container to workspace 9 $tag9
bindsym $super+Shift+0 move container to workspace 10 $tag10

# resize window (you can also use the mouse for that)
###############[KEYBINDINGS]##################
#show notification center
#bindsym $super+p exec "kill -s USR1 $(pidof deadd-notification-center)"

# take screenshot (full screen / selection), saved to ~/Screenshots and copied to clipboard
set $screenshot_file ~/Screenshots/screenshot-$(date +%F_%H-%M-%S).png
bindsym Print exec 'mkdir -p ~/Screenshots && f=$screenshot_file && grim "$f" && wl-copy < "$f"'
bindsym $super+Print exec 'mkdir -p ~/Screenshots && f=$screenshot_file && grim -g "$(slurp)" "$f" && wl-copy < "$f"'

# start a terminal
bindsym $super+Return exec $terminal
bindsym $super+e exec "thunar"

# open rofi
bindsym $super+r exec "rofi -show drun"
bindsym $super+p exec pycharm-professional
bindsym $super+w exec webstorm

# start chrome
bindsym $super+c exec "firefox"

# Sound output
bindsym XF86AudioRaiseVolume exec  pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle # mute sound

bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

#Sound input
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Sleep key
bindsym XF86Sleep exec systemctl suspend

# Screen brightness controls
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Mouse
#
###########[OTHER STUFF]##################
# reload the configuration file
bindsym $super+Shift+c reload

# power menu: lock, suspend, hibernate, reboot, poweroff, exit sway
set $mode_system "(l)ock (s)leep (h)ibernate (r)eboot (p)oweroff (e)xit"
mode $mode_system {
        bindsym l exec swaylock -f; mode "default"
        bindsym s exec swaylock -f && systemctl suspend; mode "default"
        bindsym h exec swaylock -f && systemctl hibernate; mode "default"
        bindsym p exec systemctl poweroff; mode "default"
        bindsym r exec systemctl reboot; mode "default"
        bindsym e exec swaymsg exit; mode "default"
        bindsym Return mode "default"
        bindsym Escape mode "default"
}
bindsym $super+Shift+q mode $mode_system

for_window [instance="Origin.exe"] floating enable

# don't lock or blank the screen while a window is fullscreen (videos, games)
for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"] inhibit_idle fullscreen

### Idle configuration
# Lock the screen after 360 seconds of inactivity, turn off the displays after
# 600 seconds and turn them back on when resumed. Also lock before sleep.
exec swayidle -w \
         timeout 360 'swaylock -f' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f'

bindsym $super+l exec swaylock -f

